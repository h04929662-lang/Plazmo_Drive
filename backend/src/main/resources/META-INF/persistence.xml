<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="plazmoPU" transaction-type="JTA">
        <jta-data-source>java:app/jdbc/plazmodrive</jta-data-source>
        <class>com.plazmodrive.api.model.Usuario</class>
        <class>com.plazmodrive.api.model.Vehiculo</class>
        <class>com.plazmodrive.api.model.Reserva</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- Crea/actualiza las tablas automáticamente (solo para desarrollo) -->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
        </properties>
    </persistence-unit>
</persistence>
